*.bin
*.npz

# ---------------------------------------------------------------------------
# Generated reports and analysis output
# ---------------------------------------------------------------------------
*.report.json
*.analysis.json
/out/
/output/

# ---------------------------------------------------------------------------
# Databases and dumps
# PostgreSQL is authoritative at runtime, never in the repository.
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
*.sql.gz
*.rdb
/pgdata/
/postgres-data/
/redis-data/

